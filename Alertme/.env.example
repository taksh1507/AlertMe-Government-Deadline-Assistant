# Shared API / web server
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=alertme
PERSONAL_DB_NAME=alertme_personal
JWT_SECRET_KEY=
HOST=127.0.0.1
PORT=5000
# Set production only behind an HTTPS endpoint (enables secure browser cookies).
ALERTME_ENV=development
# Desktop client: same API used by the website. Remote hosts require HTTPS.
ALERTME_API_URL=http://127.0.0.1:5000
# Optional browser origins when using a separate web host; same-origin needs none.
CORS_ORIGINS=
# Optional publishing account. Generate a password hash with Werkzeug.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Optional email delivery
SMTP_SERVER=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
# Optional SMS delivery and contact verification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
# Reminder worker timezone. For example: UTC or Asia/Kolkata.
APP_TIMEZONE=UTC
